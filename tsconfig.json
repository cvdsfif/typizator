{
    "compilerOptions": {
        "module": "esnext",
        "esModuleInterop": true,
        "target": "es2020",
        "moduleResolution": "bundler",
        "types": [
            "node",
            "jest"
        ],
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": ".",
        "strict": true,
        "declaration": true,
        "noEmit": true,
        "lib": [
            "es2020",
            "es2021",
            "esnext.weakref"
        ]
    },
    "include": [
        "src",
        "tests"
    ]
}